# Docu Environment Configuration Example
# Copy this file to .env.local for local development.

# Application Base URL (e.g. https://docu.app or http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node Environment
NODE_ENV=production

# Application Session Secret (Used for HMAC signing of user session cookies & sandbox tokens)
DOCU_SECRET=replace-with-a-secure-random-64-character-hex-secret

# Stripe Billing Configuration (Optional for sandbox testing; required for live payments)
# STRIPE_SECRET_KEY=sk_test_... or sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
